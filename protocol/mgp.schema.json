{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory Graph Protocol 1.1 (1.0 compatible)",
  "oneOf": [
    {
      "type": "object",
      "required": ["protocol", "source", "nodes", "edges"],
      "properties": {
        "protocol": {
          "const": "mgp/1.1"
        },
        "mode": {
          "enum": ["snapshot", "delta"]
        },
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!.*[\\u0000-\\u001f]).*\\S.*$"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "sources": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "nodes": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 250000,
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "deleted": {
          "type": "object",
          "required": [],
          "properties": {
            "nodes": {
              "type": "array",
              "maxItems": 50000,
              "items": {
                "$ref": "#/$defs/deletedNode"
              }
            },
            "edges": {
              "type": "array",
              "maxItems": 250000,
              "items": {
                "$ref": "#/$defs/deletedEdge"
              }
            }
          },
          "additionalProperties": false
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "source", "nodes", "edges"],
