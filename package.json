{
  "name": "memory-galaxy",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs tests/test-mgp.mjs",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "preview": "node scripts/serve.mjs --root dist --base-path /memory-galaxy/",
    "pretest:e2e": "npm run build",
    "test:smoke": "playwright test --grep @deployment",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop": "electron .",
    "desktop:pack": "electron-builder --publish never",
    "test:desktop": "node --test tests/desktop/native.test.mjs",
    "test:storage": "node --test tests/desktop/storage.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "prettier": "3.9.10",
    "yaml": "2.9.1"
  },
  "main": "desktop/main.mjs",
  "description": "Offline memory workspace and galaxy explorer",
  "author": "小男孩",
  "productName": "Memory Galaxy",
  "homepage": "https://github.com/littleboylinlin/memory-galaxy",
  "desktopName": "memory-galaxy.desktop"
}
